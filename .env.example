# Lấy Project URL và anon/public key tại Supabase Dashboard → Project Settings → API.
# Lấy Project ID trong Project Settings → General (hoặc từ URL project trên Dashboard).
# KHÔNG BAO GIỜ dùng service_role key ở ứng dụng phía trình duyệt.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_ID=xxxx

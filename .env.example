# Lấy Project URL và publishable key tại Supabase Dashboard → Project Settings → API.
# Lấy Project ID trong Project Settings → General (hoặc từ URL project trên Dashboard).
# KHÔNG BAO GIỜ dùng service_role key ở ứng dụng phía trình duyệt.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Project cũ có thể dùng VITE_SUPABASE_ANON_KEY thay cho publishable key.
SUPABASE_PROJECT_ID=xxxx

# Enable in an isolated Supabase environment after applying migrations 001–004.
VITE_ENABLE_CLOUD_AUTH=false
